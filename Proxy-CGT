-- ==========================================
-- KONFIGURASI MODERATION PROXY (ON-DEMAND + WRENCH)
-- ==========================================
local CMD_DELAY = CMD_DELAY or 1100 -- Jeda tunggu balasan command server (ms)
-- ==========================================

local state = {
    growid = "",
    userid = "",
    dateCreated = "-",
    lastLogin = "-",
    verified = "Tidak",
    discord = "-",
    hrs = "-",
    ip = "-",

    -- Data on-demand
    ridHeader = "",
    ridAccounts = {},
    seenRid = {},

    ipHeader = "",
    ipAccounts = {},
    seenIp = {},

    ipInfoOrg = "-",
    ipInfoHostname = "-",
    ipInfoLocation = "-",
    ipInfoTimezone = "-",
    ipInfoPostal = "-",

    -- Status perekaman & mode
    capturing = false,
    capturePhase = nil, -- "INFO", "RID", "IP"
    wrenchMode = false,
    injectBackInNextDialog = false
}

local pendingAction = nil   -- "INFO", "RID", "IP", "IPINFO"
local pendingTarget = nil

local function stripColor(str)
    return (tostring(str or ""):gsub("`.", ""))
end

local function safeDlg(str)
    return tostring(str or "-"):gsub("|", "/"):gsub("[\r\n]", " ")
end

local function sendCmd(cmd)
    SendPacket(2, "action|input\n|text|" .. cmd)
end

